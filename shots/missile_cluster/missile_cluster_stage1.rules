ID = "5000.vps_missile_cluster_stage1"
Range = 400
IdealRange = 400
Speed = 20
Stage2 = &<missile_cluster_stage2.rules>

Components
{
	Physics
	{
		Type = BoxPhysics
		Size = [1.5, .7]
		Density = 0.1
		LinearDamping = 0.2
		FrameOfReferenceDuration = 2.5
	}

	Homing
	{
		Type = TargetHoming
		TurnVelocity = 120d
		Delay = .2
		AvoidanceRaycastDistance = 350
		VelocityCompensation = 60%
	}

	Acceleration
	{
		Type = Acceleration
		Acceleration = 40
	}

	DeployDeath
	{
		Type = DeathByLifetime
		Lifetime = 2.5
		FactorEffectsWith = Targetable

		OnDeath
		{
			HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &~/Stage2
					Count = 8
					Distance = 1
					Arc = [-60d, 120d]
					InheritVelocity = true
					ScaleHealth = true
				}
			]
		}
	}

	Sprite
	{
		Type = Sprite
		IsLit = true
		Sprite
		{
			Texture
			{
				File = "missile_cluster.png"
				MipLevels = max
			}
			Size = [2.5, 1]
		}

		NormalsTexture
		{
			File = "missile_cluster_normals.png"
			MipLevels = max
		}
	}

	ClusterLightsSprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper1
		Offset = [1, 0]
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "missile_cluster_light.png"
					MipLevels = max
					SampleMode = Linear
				}
				Size = [1.0, 1.0]
				TargetBlendMode = Add
			}
			FrameCount = 4
			FrameSize = [64, 64]
			FramesPerRow = 4
			FramesPerSecond = 15
		}
	}

	MediaEffects
	{
		Type = MediaEffects
		Offset = [-1.1, 0]
		Rotation = 180d
		MediaEffects
		[
			&<./Data/shots/missile_he/particles/missile_he_thruster_fire.rules>
			&<./Data/shots/missile_he/particles/missile_he_thruster_smoke.rules>
			&<./Data/shots/missile_he/particles/missile_he_thruster_plume.rules>
			&<./Data/shots/missile_he/particles/missile_he_thruster_plume_light.rules>
		]
	}

	Targetable
	{
		Type = Targetable
		Health = 2000
		TargetCategory = "missile"

		// No AOE damage when shot down.
		OnDeath = &../Hit/HitFriendly
	}

	Hit
	{
		Type = SimpleHit
		SourcePartCollisionDelay = 1.5/30

		HitOperational
		{
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 20000
					Radius = 7
					Filter
					{
						Friendlies = true
					}
				}
				{
					Type = Impulse;
					Impulse = 50;
				}
			]

			MediaEffects
			[
				&<./Data/shots/missile_he/particles/missile_he_hit.rules>
				&<./Data/shots/missile_he/particles/missile_he_flash.rules>
				&<./Data/shots/missile_he/particles/missile_he_smoke.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/shots/missile_he/sounds/launcher_rocket_impact_01.wav"
					Volume = 1
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}

		HitShield = &HitOperational
		HitStructural = &HitOperational

		HitFriendly
		{
			MediaEffects
			[
				&<./Data/shots/missile_he/particles/missile_he_hit.rules>
				&<./Data/shots/missile_he/particles/missile_he_flash.rules>
				&<./Data/shots/missile_he/particles/missile_he_smoke.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/shots/missile_he/sounds/launcher_rocket_impact_01.wav"
					Volume = .75
					SpeedVariation = .4
				}
			]
		}
	}
}
